<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Main background matching the header -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/border_color" />
        </shape>
    </item>
    <!-- Right border to separate groups -->
    <item android:left="-1dp" android:top="-1dp" android:bottom="-1dp">
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="@color/stroke_color" />
        </shape>
    </item>
    <!-- Bottom border to separate from subcategories -->
    <item android:left="-1dp" android:top="-1dp" android:right="-1dp">
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="@color/stroke_color" />
        </shape>
    </item>
</layer-list>