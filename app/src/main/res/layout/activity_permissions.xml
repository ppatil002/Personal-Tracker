<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#0F172A"
    android:fitsSystemWindows="true"
    android:gravity="center_horizontal">

    <ImageView
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_marginTop="40dp"
        android:src="@drawable/ic_cloud_upload"
        android:contentDescription="Permissions" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="System Setup Required"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginTop="16dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="To ensure reliable background backups and tracking, please grant the following permissions."
        android:textColor="#94A3B8"
        android:textSize="14sp"
        android:gravity="center"
        android:layout_marginTop="8dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Notification Permission -->
            <Button
                android:id="@+id/btnNotificationPermission"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Grant Notification Permission"
                android:backgroundTint="#1E293B"
                android:textColor="#FFFFFF"
                android:layout_marginBottom="12dp" />


            <!-- Google Drive Access -->
            <Button
                android:id="@+id/btnGoogleDrive"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Connect Google Drive"
                android:backgroundTint="#1E293B"
                android:textColor="#FFFFFF"
                android:layout_marginBottom="12dp" />

            <!-- Exact Alarm Permission -->
            <Button
                android:id="@+id/btnAlarmPermission"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Allow Exact Alarms"
                android:backgroundTint="#1E293B"
                android:textColor="#FFFFFF"
                android:layout_marginBottom="12dp" />

            <!-- Battery Optimization Permission -->
            <Button
                android:id="@+id/btnBatteryOptimization"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Ignore Battery Optimization"
                android:backgroundTint="#1E293B"
                android:textColor="#FFFFFF"
                android:layout_marginBottom="12dp" />
        </LinearLayout>
    </ScrollView>

    <Button
        android:id="@+id/btnContinue"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="CONTINUE TO APP"
        android:backgroundTint="#22D3EE"
        android:textColor="#0F172A"
        android:textStyle="bold"
        android:layout_marginBottom="24dp" />

</LinearLayout>
